<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/primary"
            android:paddingStart="@dimen/spacing_lg"
            android:paddingEnd="@dimen/spacing_lg"
            android:paddingTop="48dp"
            android:paddingBottom="@dimen/spacing_lg">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Settings"
                android:textSize="@dimen/text_title_2"
                android:textColor="@color/white"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_lg">

            <!-- Permissions Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                app:cardCornerRadius="@dimen/corner_md"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/surface"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Permissions"
                        android:textSize="@dimen/text_title_3"
                        android:textColor="@color/text_primary"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Grant notification and SMS access to track your spending."
                        android:textSize="@dimen/text_caption"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="@dimen/spacing_xxs"
                        android:layout_marginBottom="@dimen/spacing_md" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/grantNotificationBtn"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Grant Notification Access"
                        app:cornerRadius="@dimen/corner_sm"
                        app:backgroundTint="@color/primary"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_body_3"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="@dimen/spacing_sm" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/grantSmsBtn"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Grant SMS Access"
                        app:cornerRadius="@dimen/corner_sm"
                        app:strokeColor="@color/primary"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/text_body_3"
                        android:fontFamily="sans-serif-medium" />

                    <LinearLayout
                        android:id="@+id/permStatusLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="@dimen/spacing_md">

                        <View
                            android:id="@+id/permDot"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/perm_dot"
                            android:layout_marginEnd="@dimen/spacing_xs" />

                        <TextView
                            android:id="@+id/permStatusText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Setup needed"
                            android:textSize="@dimen/text_caption"
                            android:textColor="@color/semantic_red" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Language Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                app:cardCornerRadius="@dimen/corner_md"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/surface"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Language"
                        android:textSize="@dimen/text_title_3"
                        android:textColor="@color/text_primary"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="@dimen/spacing_md" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/englishBtn"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="English"
                        app:cornerRadius="@dimen/corner_sm"
                        app:strokeColor="@color/primary"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/text_body_3"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="@dimen/spacing_sm" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/arabicBtn"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="العربية"
                        app:cornerRadius="@dimen/corner_sm"
                        app:strokeColor="@color/primary"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/text_body_3"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Currency Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                app:cardCornerRadius="@dimen/corner_md"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/surface"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Currency"
                        android:textSize="@dimen/text_title_3"
                        android:textColor="@color/text_primary"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="@dimen/spacing_md" />

                    <LinearLayout
                        android:id="@+id/currencyContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- About Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/corner_md"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/surface"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="About"
                        android:textSize="@dimen/text_title_3"
                        android:textColor="@color/text_primary"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Finance Observer v1.0"
                        android:textSize="@dimen/text_body_3"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="@dimen/spacing_xs" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Finance Observer tracks your spending by analyzing SMS and notifications. All data stays on your device."
                        android:textSize="@dimen/text_caption"
                        android:textColor="@color/text_tertiary"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Space
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_md" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
