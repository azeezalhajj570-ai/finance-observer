<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md"
        android:paddingTop="@dimen/spacing_sm"
        android:paddingBottom="@dimen/spacing_xs"
        android:background="@color/status_bar">

        <TextView
            android:id="@+id/headerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Finance Observer"
            android:textSize="@dimen/text_headline"
            android:textColor="@color/accent_signature"
            android:fontFamily="sans-serif-medium"
            android:gravity="start" />

        <TextView
            android:id="@+id/headerStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⊙ Active"
            android:textSize="@dimen/text_caption"
            android:textColor="@color/accent_positive"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <!-- Spending Summary Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_sm"
                app:cardCornerRadius="@dimen/corner_md"
                app:cardElevation="@dimen/card_elevation"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="This Month"
                        android:textSize="@dimen/text_caption"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/totalSpendingText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$0.00"
                        android:textSize="@dimen/text_amount_large"
                        android:textColor="@color/text_primary"
                        android:fontFamily="monospace"
                        android:layout_marginTop="@dimen/spacing_xxs" />

                    <TextView
                        android:id="@+id/spendingTrend"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- vs last month"
                        android:textSize="@dimen/text_caption"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="@dimen/spacing_xxs" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Quick Stats Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/spacing_lg">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    app:cardCornerRadius="@dimen/corner_md"
                    app:cardElevation="@dimen/card_elevation"
                    app:cardBackgroundColor="@color/surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Subscriptions"
                            android:textSize="@dimen/text_caption"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:id="@+id/subscriptionCountText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 active"
                            android:textSize="@dimen/text_title"
                            android:textColor="@color/text_primary"
                            android:layout_marginTop="@dimen/spacing_xxs" />

                        <TextView
                            android:id="@+id/subscriptionTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$0.00/mo"
                            android:textSize="@dimen/text_caption"
                            android:textColor="@color/text_secondary"
                            android:fontFamily="monospace"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_xs"
                    app:cardCornerRadius="@dimen/corner_md"
                    app:cardElevation="@dimen/card_elevation"
                    app:cardBackgroundColor="@color/surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Alerts"
                            android:textSize="@dimen/text_caption"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:id="@+id/anomalyCountText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="@dimen/text_display_medium"
                            android:textColor="@color/accent_critical"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginTop="@dimen/spacing_xxs" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Anomalies"
                            android:textSize="@dimen/text_caption"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Observations Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● Observations"
                android:textSize="@dimen/text_caption"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <!-- Observations Container (populated programmatically) -->
            <LinearLayout
                android:id="@+id/observationsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="@dimen/spacing_lg" />

            <!-- Recent Transactions Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/spacing_sm">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Recent"
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/transactionCountText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 transactions"
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/text_tertiary" />
            </LinearLayout>

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/emptyView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="@dimen/spacing_xxl"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⊙"
                    android:textSize="48sp"
                    android:textColor="@color/text_tertiary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No transactions yet"
                    android:textSize="@dimen/text_body"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Finance Observer is working in the\nbackground. We'll show things as\nwe detect them."
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/text_tertiary"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.4" />
            </LinearLayout>

            <!-- Transaction List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/transactionRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:nestedScrollingEnabled="false" />

            <!-- Bottom spacer for nav -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_md" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_nav_height"
        android:background="@color/navigation_bar"
        app:itemIconTint="@color/bottom_nav_color"
        app:itemTextColor="@color/bottom_nav_color"
        app:itemRippleColor="@color/ripple"
        app:labelVisibilityMode="labeled"
        app:elevation="0dp"
        app:menu="@menu/bottom_nav_menu" />

</LinearLayout>
