<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/transaction_item_height"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/spacing_md"
    android:paddingEnd="@dimen/spacing_md"
    android:background="@color/surface"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <!-- Category Badge -->
    <FrameLayout
        android:layout_width="@dimen/category_icon_size"
        android:layout_height="@dimen/category_icon_size"
        android:layout_marginEnd="@dimen/spacing_sm">

        <View
            android:id="@+id/txnCategoryBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/category_icon_bg" />

        <TextView
            android:id="@+id/txnCategoryIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="DF"
            android:textSize="12sp"
            android:textColor="@color/accent_signature"
            android:fontFamily="sans-serif-medium"
            android:textAllCaps="true" />
    </FrameLayout>

    <!-- Transaction Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txnName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_body"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif" />

        <TextView
            android:id="@+id/txnMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_caption"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Amount -->
    <TextView
        android:id="@+id/txnAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textColor="@color/text_primary"
        android:fontFamily="monospace"
        android:layout_marginStart="@dimen/spacing_sm" />
</LinearLayout>
